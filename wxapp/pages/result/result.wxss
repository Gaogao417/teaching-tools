.result-loading,
.header-panel,
.trend-card,
.action-card {
  padding: 24rpx;
}

.result-screen {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.result-title {
  margin-top: 14rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.result-copy {
  margin-top: 10rpx;
  color: #556373;
  line-height: 1.7;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.metric-card {
  padding: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.metric-label {
  color: #64748b;
}

.metric-value {
  font-size: 40rpx;
  font-weight: 700;
}

.trend-head {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  align-items: center;
}

.trend-empty {
  margin-top: 20rpx;
  color: #64748b;
}

.trend-bars {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.trend-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.trend-bar {
  height: 24rpx;
  min-width: 36rpx;
  border-radius: 999rpx;
  opacity: 0.86;
}

.trend-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.action-card {
  display: flex;
  gap: 14rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
}

.ghost-action {
  background: rgba(71, 85, 105, 0.08);
  color: #475569;
}

.result-shell.layout-compact .metric-grid,
.result-shell.layout-medium .metric-grid {
  grid-template-columns: minmax(0, 1fr);
}

.result-shell.layout-compact .trend-head,
.result-shell.layout-medium .trend-head,
.result-shell.layout-compact .action-card {
  flex-direction: column;
  align-items: stretch;
}

.result-shell.layout-compact .trend-row {
  flex-direction: column;
  align-items: stretch;
}

.result-shell.layout-compact .trend-bar {
  width: 100% !important;
}

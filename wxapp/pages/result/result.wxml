<view class="screen result-shell layout-{{layoutMode}}">
  <view wx:if="{{loading}}" class="panel result-loading">结果加载中...</view>

  <view wx:elif="{{snapshot}}" class="result-screen">
    <view class="panel header-panel">
      <view class="pill">本组完成</view>
      <view class="result-title">{{snapshot.title}}</view>
      <view class="result-copy">{{snapshot.copy}}</view>
    </view>

    <view class="metric-grid">
      <view class="panel metric-card">
        <text class="metric-label">本次耗时</text>
        <text class="metric-value">{{snapshot.elapsedText}}</text>
      </view>
      <view class="panel metric-card">
        <text class="metric-label">本组最佳</text>
        <text class="metric-value">{{snapshot.bestText}}</text>
      </view>
      <view class="panel metric-card">
        <text class="metric-label">最近平均</text>
        <text class="metric-value">{{snapshot.avgText}}</text>
      </view>
      <view class="panel metric-card">
        <text class="metric-label">首答准确率</text>
        <text class="metric-value">{{snapshot.accuracyText}}</text>
      </view>
    </view>

    <view class="panel trend-card">
      <view class="trend-head">
        <view class="section-title">历史趋势</view>
        <view class="muted">与上次相比 {{snapshot.deltaText}}</view>
      </view>

      <view wx:if="{{!chartBars.length}}" class="trend-empty">暂无历史数据</view>
      <view wx:else class="trend-bars">
        <block wx:for="{{chartBars}}" wx:key="index">
          <view class="trend-row">
            <view class="trend-bar" style="width: {{item.width}}%; background: {{snapshot.color}};"></view>
            <view class="trend-copy">
              <text>{{item.elapsedText}}</text>
              <text class="muted">{{item.clearedAtText}}</text>
            </view>
          </view>
        </block>
      </view>
    </view>

    <view class="panel action-card">
      <button class="primary-btn action-btn" bindtap="retry">再练一组</button>
      <button class="ghost-btn action-btn ghost-action" bindtap="backHome">返回首页</button>
    </view>
  </view>

  <view wx:else class="panel result-loading">未找到结果数据</view>
</view>

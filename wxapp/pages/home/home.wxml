<view class="screen home-screen layout-{{layoutMode}}">
  <view class="mobile-bar" wx:if="{{useDrawer}}">
    <button class="ghost-btn nav-btn" bindtap="toggleDrawer">任务导航</button>
  </view>

  <view class="home-layout layout-{{layoutMode}}">
    <view class="tree-mask" wx:if="{{drawerOpen}}" bindtap="closeDrawer"></view>

    <view class="panel tree-panel {{drawerTreeClass}}">
      <view class="tree-header">
        <view>
          <view class="section-title">课程任务</view>
          <view class="muted tree-subtitle">年级 -> 章节 -> 任务</view>
        </view>
        <text class="tree-close" wx:if="{{useDrawer}}" bindtap="closeDrawer">关闭</text>
      </view>

      <view wx:if="{{loading}}" class="tree-loading">加载中...</view>

      <block wx:for="{{tree}}" wx:key="id">
        <view class="tree-node grade-row" bindtap="toggleGrade" data-id="{{item.id}}">
          <text>{{item.name}}</text>
          <text class="tree-arrow">{{item.arrowText}}</text>
        </view>

        <view class="tree-branch" wx:if="{{item.expanded}}">
          <block wx:for="{{item.chapters}}" wx:key="id">
            <view class="tree-node chapter-row" bindtap="toggleChapter" data-id="{{item.id}}">
              <text>{{item.name}}</text>
              <text class="tree-arrow">{{item.arrowText}}</text>
            </view>

            <view class="tree-branch task-branch" wx:if="{{item.expanded}}">
              <block wx:for="{{item.tasks}}" wx:key="id">
                <view
                  class="{{item.rowClass}}"
                  bindtap="selectTask"
                  data-task-id="{{item.id}}"
                >
                  <view class="task-copy">
                    <text class="task-title">{{item.title}}</text>
                    <text class="task-meta">{{item.summary}}</text>
                  </view>
                </view>
              </block>
            </view>
          </block>
        </view>
      </block>
    </view>

    <view class="panel detail-panel">
      <view wx:if="{{!selectedTask}}" class="empty-state">
        <text>请先从左侧选择任务</text>
      </view>

      <block wx:elif="{{selectedTask}}">
        <view class="detail-hero" style="border-color: {{selectedTaskColor}}33;">
          <view class="pill-row">
            <text class="pill">{{selectedTask.difficultyLabel}}</text>
          </view>
          <view class="detail-title">{{selectedTask.title}}</view>
          <view class="detail-summary">{{selectedTaskSummary}}</view>
        </view>

        <view class="detail-grid">
          <view class="detail-card">
            <view class="card-title">样题</view>
            <view class="card-copy">{{selectedTaskSamplePrompt}}</view>
            <view class="card-tip">首页只展示题干，不提前展示答案。</view>
          </view>

          <view class="detail-card">
            <view class="card-title">解题步骤</view>
            <view class="steps-list">
              <block wx:for="{{selectedTask.steps}}" wx:key="index">
                <view class="step-item">
                  <text class="step-index">{{index + 1}}</text>
                  <text class="step-copy">{{item}}</text>
                </view>
              </block>
            </view>
          </view>
        </view>

        <view class="detail-card">
          <view class="card-title">训练历史</view>
          <view wx:if="{{historyError}}" class="history-empty">{{historyError}}</view>
          <view wx:elif="{{!taskHistory.length}}" class="history-empty">暂无训练记录</view>
          <view wx:else class="history-list">
            <block wx:for="{{taskHistory}}" wx:key="index">
              <view class="history-item">
                <text class="history-time">{{item.elapsedText}}</text>
                <text class="history-meta">首答准确率 {{item.accuracyText}}</text>
                <text class="history-date">{{item.clearedAtText}}</text>
              </view>
            </block>
          </view>
        </view>

        <button class="primary-btn start-btn" bindtap="startPractice">开始练习</button>
      </block>
    </view>
  </view>
</view>

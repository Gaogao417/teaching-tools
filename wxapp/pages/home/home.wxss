.home-screen {
  padding: 24rpx;
  box-sizing: border-box;
}

.mobile-bar {
  margin-bottom: 20rpx;
}

.nav-btn {
  height: 76rpx;
  line-height: 76rpx;
}

.home-layout {
  display: flex;
  gap: 20rpx;
  position: relative;
}

.home-layout.layout-compact,
.home-layout.layout-medium {
  flex-direction: column;
}

.tree-panel {
  width: 300rpx;
  max-width: 34%;
  flex-shrink: 0;
  padding: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.detail-panel {
  flex: 1;
  min-height: 0;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.tree-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.tree-subtitle {
  margin-top: 6rpx;
  font-size: 24rpx;
}

.tree-close {
  color: #64748b;
  font-size: 26rpx;
}

.tree-loading {
  padding: 24rpx 0;
  color: #64748b;
}

.tree-branch {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding-left: 18rpx;
  margin-left: 8rpx;
  border-left: 1px dashed rgba(148, 163, 184, 0.35);
}

.task-branch {
  padding-top: 4rpx;
}

.tree-node {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: 20rpx;
}

.grade-row {
  background: rgba(201, 111, 58, 0.08);
  font-weight: 700;
}

.chapter-row {
  background: rgba(71, 85, 105, 0.05);
  color: #475569;
}

.task-row {
  align-items: flex-start;
  border: 1px solid rgba(148, 163, 184, 0.16);
  background: rgba(255, 255, 255, 0.7);
}

.task-row.active {
  border-color: rgba(201, 111, 58, 0.28);
  background: rgba(201, 111, 58, 0.11);
}

.tree-arrow {
  color: #64748b;
}

.task-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.task-title {
  font-size: 28rpx;
  font-weight: 700;
}

.task-meta {
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.5;
}

.empty-state {
  min-height: 360rpx;
  border-radius: 24rpx;
  border: 1px dashed rgba(148, 163, 184, 0.32);
  display: flex;
  justify-content: center;
  align-items: center;
  color: #64748b;
}

.detail-hero {
  border-radius: 24rpx;
  border: 1px solid rgba(201, 111, 58, 0.18);
  background: linear-gradient(135deg, rgba(201, 111, 58, 0.12), rgba(255, 252, 247, 0.95));
  padding: 24rpx;
}

.pill-row {
  margin-bottom: 14rpx;
}

.detail-title {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.4;
}

.detail-summary {
  margin-top: 10rpx;
  color: #556373;
  line-height: 1.7;
}

.detail-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.detail-card {
  border-radius: 24rpx;
  border: 1px solid rgba(148, 163, 184, 0.16);
  background: rgba(255, 251, 245, 0.82);
  padding: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
}

.card-copy,
.card-tip,
.history-empty {
  color: #5b6876;
  line-height: 1.7;
}

.card-tip {
  font-size: 24rpx;
}

.steps-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.step-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.step-index {
  width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 999rpx;
  background: rgba(201, 111, 58, 0.12);
  color: #a04f22;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.step-copy {
  flex: 1;
  line-height: 1.7;
}

.history-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.history-item {
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.76);
  border: 1px solid rgba(148, 163, 184, 0.16);
  padding: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.history-time {
  font-size: 32rpx;
  font-weight: 700;
}

.history-meta,
.history-date {
  color: #64748b;
  font-size: 24rpx;
}

.start-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin-top: auto;
}

.tree-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.32);
  z-index: 8;
}

.drawer-tree {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: 148rpx;
  bottom: 24rpx;
  width: auto;
  max-width: none;
  z-index: 9;
  transform: translateX(-120%);
  transition: transform 0.24s ease;
}

.drawer-tree.open {
  transform: translateX(0);
}

.home-screen.layout-compact .detail-grid,
.home-screen.layout-medium .detail-grid,
.home-screen.layout-compact .history-list,
.home-screen.layout-medium .history-list {
  grid-template-columns: minmax(0, 1fr);
}

.home-screen.layout-compact .task-title {
  font-size: 26rpx;
}

.home-screen.layout-compact .detail-title {
  font-size: 34rpx;
}

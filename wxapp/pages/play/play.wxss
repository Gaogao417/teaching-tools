.loading-panel {
  padding: 32rpx;
}

.play-screen {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.main-layout {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
}

.main-layout.layout-compact,
.main-layout.layout-medium {
  flex-direction: column;
}

.bottom-panel {
  padding: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.feedback-title {
  font-size: 28rpx;
  font-weight: 700;
}

.feedback-body {
  color: #556373;
  line-height: 1.7;
}

<view class="screen">
  <view wx:if="{{loading}}" class="panel loading-panel">正在创建练习会话...</view>

  <view wx:elif="{{currentProblem}}" class="play-screen layout-{{layoutMode}}">
    <practice-header
      layoutMode="{{layoutMode}}"
      title="{{currentProblem.prompt}}"
      currentIndex="{{currentIndex}}"
      total="{{problems.length}}"
      formattedTime="{{formattedTime}}"
      progressPercent="{{progressPercent}}"
      bindbackhome="backHome"
      bindrestart="restart"
    />

    <view class="main-layout layout-{{layoutMode}}">
      <triangle-stage
        layoutMode="{{layoutMode}}"
        roleCards="{{roleCards}}"
      />

      <practice-panel
        layoutMode="{{layoutMode}}"
        problem="{{currentProblem}}"
        actionBanner="{{actionBanner}}"
        selectedNumeratorLabel="{{selectedNumeratorLabel}}"
        selectedDenominatorLabel="{{selectedDenominatorLabel}}"
        roleCards="{{roleCards}}"
        edgeFields="{{edgeFields}}"
        knownFields="{{knownFields}}"
        ratioFields="{{ratioFields}}"
        thirdInput="{{thirdInput}}"
        finalInputs="{{finalInputs}}"
        bindchooserole="chooseRole"
        bindedgeinput="handleEdgeInput"
        bindknowninput="handleKnownInput"
        bindratioinput="handleRatioInput"
        bindthirdinput="handleThirdInput"
        bindfinalinput="handleFinalInput"
        bindsubmitanswer="submitCurrent"
      />
    </view>

    <view class="panel bottom-panel">
      <view class="feedback-title">即时反馈</view>
      <view class="feedback-body">{{feedbackMessage || '答错时会给出下一步提示；答对后 700ms 自动进入下一题。'}}</view>
    </view>
  </view>
</view>

page {
  --color-ink: #1e293b;
  --color-primary: #f97316;
  --color-primary-strong: #c96f3a;
  --color-line: rgba(30, 41, 59, 0.12);
  --color-bg: #fdf8f3;
  --color-panel: rgba(255, 253, 248, 0.92);
  --color-muted: #64748b;
  --color-accent-bg: rgba(249, 115, 22, 0.1);
  --color-accent-text: #a04f22;

  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 48rpx;
  --space-6: 64rpx;

  --radius-sm: 12rpx;
  --radius-md: 24rpx;
  --radius-lg: 36rpx;
  --radius-pill: 999rpx;

  --shadow-color: 30, 41, 59;
  --shadow-sm: 0 4rpx 16rpx rgba(var(--shadow-color), 0.04);
  --shadow-md: 0 16rpx 40rpx rgba(var(--shadow-color), 0.08);

  --text-xs: 24rpx;
  --text-sm: 28rpx;
  --text-base: 32rpx;
  --text-md: 40rpx;
  --text-lg: 48rpx;
  --text-xl: 64rpx;
  --weight-medium: 500;
  --weight-bold: 700;
  --leading-normal: 1.5;

  --text-main: var(--color-ink);
  --text-muted: var(--color-muted);
  --panel-bg: var(--color-panel);
  --panel-border: rgba(148, 163, 184, 0.2);
  --panel-shadow: 0 16rpx 36rpx rgba(70, 56, 38, 0.08);
  --panel-padding: var(--space-4);
  --btn-height-md: 76rpx;
  --btn-height-lg: 88rpx;

  --bg: var(--color-bg);
  --panel: var(--panel-bg);
  --ink: var(--text-main);
  --muted: var(--text-muted);
  --line: var(--color-line);
  --primary: var(--color-primary);

  min-height: 100%;
  background:
    radial-gradient(circle at top left, rgba(235, 214, 185, 0.9), transparent 30%),
    radial-gradient(circle at bottom right, rgba(209, 228, 215, 0.88), transparent 26%),
    linear-gradient(180deg, #f6efe3 0%, #efe5d4 100%);
  color: var(--text-main);
  font-family: "PingFang SC", "Hiragino Sans GB", sans-serif;
  line-height: var(--leading-normal);
}

.screen {
  min-height: 100vh;
}

.panel {
  background: var(--panel);
  border: 1px solid var(--panel-border);
  border-radius: 28rpx;
  box-shadow: var(--panel-shadow);
}

.panel-pad {
  padding: var(--panel-padding);
}

.section-title {
  font-size: var(--text-sm);
  font-weight: var(--weight-bold);
}

.text-muted {
  color: var(--muted);
}

.pill {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 18rpx;
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  background: var(--color-accent-bg);
  color: var(--color-accent-text);
}

.btn,
.btn-primary,
.btn-secondary,
.btn-ghost {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: var(--btn-height-md);
  padding: 0 28rpx;
  border: none;
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  font-weight: var(--weight-bold);
  box-sizing: border-box;
}

.btn-primary {
  min-height: var(--btn-height-lg);
  padding: 0 32rpx;
  font-size: 30rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-strong));
  color: #fff;
}

.btn-secondary {
  background: var(--color-accent-bg);
  color: var(--color-accent-text);
}

.btn-ghost {
  background: rgba(71, 85, 105, 0.08);
  color: #475569;
}

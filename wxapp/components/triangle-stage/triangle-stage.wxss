.stage-panel {
  padding: 22rpx;
}

.stage-panel.layout-wide {
  width: 290rpx;
  flex-shrink: 0;
}

.panel-title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 18rpx;
}

.triangle-card {
  border-radius: 24rpx;
  padding: 20rpx;
  background:
    repeating-linear-gradient(90deg, transparent, transparent 30rpx, rgba(201, 111, 58, 0.06) 30rpx, rgba(201, 111, 58, 0.06) 31rpx),
    repeating-linear-gradient(0deg, transparent, transparent 30rpx, rgba(201, 111, 58, 0.06) 30rpx, rgba(201, 111, 58, 0.06) 31rpx),
    linear-gradient(180deg, rgba(255, 253, 248, 0.98), rgba(252, 244, 231, 0.92));
  border: 1px solid rgba(201, 111, 58, 0.16);
}

.triangle-shape {
  width: 0;
  height: 0;
  margin: 10rpx auto 24rpx;
  border-left: 90rpx solid transparent;
  border-right: 0 solid transparent;
  border-bottom: 150rpx solid rgba(201, 111, 58, 0.18);
}

.stage-panel.layout-medium .triangle-shape {
  border-left-width: 120rpx;
  border-bottom-width: 180rpx;
}

.stage-panel.layout-wide .triangle-shape {
  border-left-width: 140rpx;
  border-bottom-width: 210rpx;
}

.role-pill {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  border: 1px solid;
  background: rgba(255, 255, 255, 0.76);
  margin-bottom: 12rpx;
  font-size: 24rpx;
}

<view class="panel stage-panel layout-{{layoutMode}}">
  <view class="panel-title">三角形教具区</view>
  <view class="triangle-card">
    <view class="triangle-shape"></view>
    <block wx:for="{{roleCards}}" wx:key="id">
      <view class="role-pill" style="border-color: {{item.color}}44; color: {{item.color}};">
        <text>{{item.label}}</text>
        <text>{{item.side}}</text>
      </view>
    </block>
  </view>
</view>

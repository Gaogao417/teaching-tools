.task-panel {
  flex: 1;
  padding: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.action-banner {
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  border: 1px solid rgba(201, 111, 58, 0.22);
  background: linear-gradient(120deg, rgba(201, 111, 58, 0.12), rgba(255, 252, 247, 0.96));
  color: #a04f22;
  font-size: 28rpx;
  line-height: 1.6;
}

.task-shell {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.formula-card {
  border-radius: 24rpx;
  border: 1px solid rgba(201, 111, 58, 0.2);
  background: linear-gradient(180deg, rgba(255, 253, 248, 0.98), rgba(252, 244, 231, 0.94));
  padding: 24rpx;
  text-align: center;
}

.formula-main {
  font-size: 42rpx;
  font-weight: 700;
  color: #a04f22;
}

.formula-sub {
  margin-top: 10rpx;
  color: #64748b;
}

.slot-grid,
.field-grid,
.stepper-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.choice-grid.layout-wide {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.choice-grid.layout-compact,
.choice-grid.layout-medium {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.slot-card,
.choice-card,
.field-card,
.step-card {
  border-radius: 22rpx;
  border: 1px solid rgba(148, 163, 184, 0.16);
  background: rgba(255, 255, 255, 0.8);
  padding: 18rpx;
}

.slot-label,
.field-label,
.step-head {
  font-size: 26rpx;
  color: #475569;
}

.slot-value {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.choice-copy {
  font-size: 28rpx;
  font-weight: 700;
}

.choice-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

.choice-actions.layout-compact {
  flex-direction: column;
}

.choice-btn {
  min-width: 180rpx;
  height: 62rpx;
  line-height: 62rpx;
  font-size: 24rpx;
  padding: 0 20rpx;
}

.choice-actions.layout-compact .choice-btn,
.choice-actions.layout-medium .choice-btn {
  width: 100%;
}

.field-input {
  width: 100%;
  min-height: 78rpx;
  border-radius: 18rpx;
  background: #fff;
  border: 1px solid rgba(148, 163, 184, 0.22);
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  margin-top: 12rpx;
  line-height: 1.4;
}

.field-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 12rpx;
}

.field-row.layout-compact {
  flex-direction: column;
  align-items: stretch;
}

.field-row-label {
  width: 100rpx;
  color: #475569;
  flex-shrink: 0;
}

.field-row.layout-compact .field-row-label {
  width: auto;
}

.inline-input,
.fraction-input {
  flex: 1;
  margin-top: 0;
}

.fraction-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 14rpx;
}

.fraction-row.layout-compact {
  flex-direction: column;
  align-items: stretch;
}

.fraction-divider {
  font-size: 40rpx;
  font-weight: 700;
  color: #475569;
}

.fraction-row.layout-compact .fraction-divider {
  align-self: center;
}

.submit-btn {
  width: 100%;
  min-height: 88rpx;
  line-height: 88rpx;
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ai-teaching.dev/state/v4/tutor-runtime-state.schema.json",
  "title": "TutorRuntimeState v4",
  "description": "Existing teaching state plus generation request history and one active slot. No resolution frames.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "session_id",
    "state_revision",
    "pinned_plan",
    "teaching_cursor",
    "workspace_revision",
    "presentation_cursor",
    "generation_slot",
    "generation_requests"
  ],
  "$defs": {
    "teaching_scope_ref": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "protocol_id",
            "beat_id"
          ],
          "properties": {
            "kind": {
              "const": "approved"
            },
            "protocol_id": {
              "type": "string",
              "pattern": "^PR-[A-Z0-9]+-[0-9]{3,}$"
            },
            "beat_id": {
              "type": "string",
              "pattern": "^BT-[0-9]{1,3}$"
            }
          },
          "description": "Approved 主线/批准分支 Protocol Beat。"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "inquiry_id",
            "local_protocol_id",
            "local_beat_id",
            "anchor"
          ],
          "properties": {
            "kind": {
              "const": "local"
            },
            "inquiry_id": {
              "type": "string",
              "pattern": "^IQ-[A-Za-z0-9._:-]{4,}$"
            },
            "local_protocol_id": {
              "type": "string",
              "pattern": "^LPR-[A-Za-z0-9._:-]{4,}$"
            },
            "local_beat_id": {
              "type": "string",
              "pattern": "^LBT-[0-9]{1,3}$"
            },
            "anchor": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "protocol_id",
                "beat_id"
              ],
              "properties": {
                "protocol_id": {
                  "type": "string",
                  "pattern": "^PR-[A-Z0-9]+-[0-9]{3,}$"
                },
                "beat_id": {
                  "type": "string",
                  "pattern": "^BT-[0-9]{1,3}$"
                }
              }
            }
          },
          "description": "session-local 局部教学（LPR/LBT 命名空间 + 主线锚点）；不再借 PR/BT 正则混装（架构 §4.1）。"
        }
      ],
      "description": "精确教学范围判别联合（approved | local）。"
    },
    "resolution_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "scope",
        "region_id",
        "frontier_unit_ids",
        "focused_unit_id",
        "evidence_refs",
        "return_target"
      ],
      "properties": {
        "frame_id": {
          "type": "string",
          "pattern": "^RF-[A-Za-z0-9._:-]{4,}$",
          "description": "id-registry RF（session runtime）。"
        },
        "scope": {
          "$ref": "#/$defs/teaching_scope_ref"
        },
        "region_id": {
          "type": "string",
          "pattern": "^SR-[0-9]{1,3}$"
        },
        "frontier_unit_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^RU-[0-9]{1,3}$"
          },
          "description": "当前讲出的单位集合（pinned plan refinement_spec.units 内——镜像强制）。"
        },
        "focused_unit_id": {
          "type": "string",
          "pattern": "^RU-[0-9]{1,3}$"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "驱动本帧的事件 sequence 引用。"
        },
        "return_target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope"
          ],
          "properties": {
            "scope": {
              "$ref": "#/$defs/teaching_scope_ref"
            },
            "frame_id": {
              "type": "string",
              "pattern": "^RF-[A-Za-z0-9._:-]{4,}$",
              "description": "返回到另一帧时携带；缺省=返回主线锚点 scope。"
            }
          }
        }
      },
      "description": "局部展开帧（架构 §4.1 ResolutionFrame）。呈现完成只结束播放，不把 frame 标为已掌握；掌握只经 checkpoint/Gate。"
    },
    "generation_error_class": {
      "enum": [
        "provider_failure",
        "timeout",
        "draft_invalid",
        "preflight_failed",
        "context_irreproducible",
        "internal_error"
      ],
      "description": "封闭生成失败分类：provider/timeout=外部模型故障；draft_invalid=模型输出解析/结构不合格；preflight_failed=整段预演失败；context_irreproducible=无法复算相同输入；系统失败不产生学生评价。"
    }
  },
  "properties": {
    "schema": {
      "const": "ai_teaching_tutor_runtime_state/v4"
    },
    "session_id": {
      "type": "string",
      "pattern": "^TS-[0-9]{4,}$"
    },
    "state_revision": {
      "type": "integer",
      "minimum": 0,
      "description": "与最后一条 committed event 的 state_revision 一致（reducer 维护）。"
    },
    "pinned_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tutor_plan_ref",
        "solution_graph_ref",
        "protocol_refs"
      ],
      "properties": {
        "tutor_plan_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_id",
            "version",
            "content_hash"
          ],
          "properties": {
            "artifact_id": {
              "type": "string",
              "pattern": "^TP-[A-Z0-9]+-[0-9]{3,}$"
            },
            "version": {
              "type": "string",
              "pattern": "^v[0-9]+$"
            },
            "content_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "solution_graph_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_id",
            "version",
            "content_hash"
          ],
          "properties": {
            "artifact_id": {
              "type": "string",
              "pattern": "^RG-[A-Z0-9]+-[0-9]{3,}$"
            },
            "version": {
              "type": "string",
              "pattern": "^v[0-9]+$"
            },
            "content_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "protocol_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_id",
              "version",
              "content_hash"
            ],
            "properties": {
              "artifact_id": {
                "type": "string",
                "pattern": "^PR-[A-Z0-9]+-[0-9]{3,}$"
              },
              "version": {
                "type": "string",
                "pattern": "^v[0-9]+$"
              },
              "content_hash": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        },
        "policy_profile_snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile_id",
            "version",
            "primary_provider",
            "fallback_provider",
            "model_id",
            "prompt_version"
          ],
          "properties": {
            "profile_id": {
              "type": "string",
              "pattern": "^PP-[A-Z0-9]+-[0-9]{3,}$"
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "primary_provider": {
              "type": "string",
              "minLength": 1
            },
            "fallback_provider": {
              "type": "string",
              "minLength": 1
            },
            "model_id": {
              "type": "string",
              "minLength": 1
            },
            "prompt_version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "presenter_generation_pin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "model_id",
            "prompt_version",
            "context_builder_version",
            "tool_catalog_version"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1,
              "description": "Presenter 生成 provider（与 policy_profile_snapshot 教学策略链、model_gate_pin 判题链三者分开）。"
            },
            "model_id": {
              "type": "string",
              "minLength": 1
            },
            "prompt_version": {
              "type": "string",
              "minLength": 1
            },
            "context_builder_version": {
              "type": "string",
              "minLength": 1
            },
            "tool_catalog_version": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "可选加法（缺省=流不含 pin；新 F7 生成会话由实现写入门禁强制携带，先例 model_gate_pin）。升级讲解模型不隐式改变判题策略。"
        }
      },
      "description": "session start 固定的 Plan/version/hash（F2 不变量）+ 独立 Presenter pin。"
    },
    "teaching_cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_id",
        "beat_id"
      ],
      "properties": {
        "protocol_id": {
          "type": "string",
          "pattern": "^PR-[A-Z0-9]+-[0-9]{3,}$"
        },
        "beat_id": {
          "type": "string",
          "pattern": "^BT-[0-9]{1,3}$"
        },
        "gate_id": {
          "type": "string",
          "pattern": "^GT-[0-9]{1,3}$"
        },
        "phase": {
          "enum": [
            "presenting",
            "awaiting_evidence",
            "gate_satisfied",
            "completed"
          ]
        }
      }
    },
    "inquiry_cursor": {
      "oneOf": [
        {
          "const": null
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inquiry_id",
            "state",
            "return_beat_id"
          ],
          "properties": {
            "inquiry_id": {
              "type": "string",
              "pattern": "^IQ-[A-Za-z0-9._:-]{4,}$"
            },
            "inquiry_protocol_id": {
              "type": "string",
              "pattern": "^PR-[A-Z0-9]+-[0-9]{3,}$"
            },
            "state": {
              "enum": [
                "clarifying",
                "supporting",
                "ready_to_return"
              ]
            },
            "return_beat_id": {
              "type": "string",
              "pattern": "^BT-[0-9]{1,3}$"
            }
          }
        }
      ],
      "description": "双游标：主线游标冻结在 inquiry 期间不变。"
    },
    "reasoning_focus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph_fact_refs"
      ],
      "properties": {
        "part_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,2}$"
        },
        "graph_fact_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^FN-[0-9]{1,3}$"
          }
        }
      }
    },
    "workspace_revision": {
      "type": "integer",
      "minimum": 0
    },
    "completed": {
      "type": "boolean"
    },
    "presentation_cursor": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "idle"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "sequence_id",
            "ordinal",
            "action_id"
          ],
          "properties": {
            "status": {
              "const": "awaiting_browser"
            },
            "sequence_id": {
              "type": "string",
              "pattern": "^PS-[0-9]{4,}$"
            },
            "ordinal": {
              "type": "integer",
              "minimum": 0
            },
            "action_id": {
              "type": "string",
              "pattern": "^(VA|WSA)-[A-Za-z0-9._:-]{4,}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "sequence_id",
            "ordinal",
            "action_id"
          ],
          "properties": {
            "status": {
              "const": "failed"
            },
            "sequence_id": {
              "type": "string",
              "pattern": "^PS-[0-9]{4,}$"
            },
            "ordinal": {
              "type": "integer",
              "minimum": 0
            },
            "action_id": {
              "type": "string",
              "pattern": "^(VA|WSA)-[A-Za-z0-9._:-]{4,}$"
            }
          }
        }
      ],
      "description": "三态判别：idle | awaiting_browser | failed（同 state/v2，浏览器 outcome 推进）。"
    },
    "generation_slot": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "idle"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "failed"
              ]
            },
            "request_id": {
              "type": "string",
              "pattern": "^GR-[A-Za-z0-9._:-]{4,}$",
              "description": "id-registry GR。"
            }
          },
          "required": [
            "status",
            "request_id"
          ]
        }
      ]
    },
    "generation_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^GR-[A-Za-z0-9._:-]{4,}$",
            "description": "id-registry GR。"
          },
          "source_request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{8,128}$"
          },
          "decision_id": {
            "type": "string",
            "pattern": "^TD-[A-Za-z0-9._:-]{4,}$"
          },
          "scope": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "protocol_id",
                  "beat_id"
                ],
                "properties": {
                  "kind": {
                    "const": "approved"
                  },
                  "protocol_id": {
                    "type": "string",
                    "pattern": "^PR-[A-Z0-9]+-[0-9]{3,}$"
                  },
                  "beat_id": {
                    "type": "string",
                    "pattern": "^BT-[0-9]{1,3}$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "inquiry_id",
                  "local_protocol_id",
                  "local_beat_id",
                  "anchor"
                ],
                "properties": {
                  "kind": {
                    "const": "local"
                  },
                  "inquiry_id": {
                    "type": "string",
                    "pattern": "^IQ-[A-Za-z0-9._:-]{4,}$"
                  },
                  "local_protocol_id": {
                    "type": "string",
                    "pattern": "^LPR-[A-Za-z0-9._:-]{4,}$"
                  },
                  "local_beat_id": {
                    "type": "string",
                    "pattern": "^LBT-[0-9]{1,3}$"
                  },
                  "anchor": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "protocol_id",
                      "beat_id"
                    ],
                    "properties": {
                      "protocol_id": {
                        "type": "string",
                        "pattern": "^PR-[A-Z0-9]+-[0-9]{3,}$"
                      },
                      "beat_id": {
                        "type": "string",
                        "pattern": "^BT-[0-9]{1,3}$"
                      }
                    }
                  }
                }
              }
            ],
            "description": "TeachingScopeRef（与 state/v3、runtime/v8 同构）。"
          },
          "reservation_revision": {
            "type": "integer",
            "minimum": 0
          },
          "epoch": {
            "type": "integer",
            "minimum": 1
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "max_attempts": {
            "type": "integer",
            "minimum": 1
          },
          "retry_policy_version": {
            "type": "string",
            "minLength": 1
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1
          },
          "retry_delays_ms": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "context": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "plan_ref": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "artifact_id",
                  "version",
                  "content_hash"
                ],
                "properties": {
                  "artifact_id": {
                    "type": "string",
                    "pattern": "^TP-[A-Z0-9]+-[0-9]{3,}$"
                  },
                  "version": {
                    "type": "string",
                    "pattern": "^v[0-9]+$"
                  },
                  "content_hash": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              },
              "graph_ref": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "artifact_id",
                  "version",
                  "content_hash"
                ],
                "properties": {
                  "artifact_id": {
                    "type": "string",
                    "pattern": "^RG-[A-Z0-9]+-[0-9]{3,}$"
                  },
                  "version": {
                    "type": "string",
                    "pattern": "^v[0-9]+$"
                  },
                  "content_hash": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              },
              "selected_fact_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^FN-[0-9]{1,3}$"
                }
              },
              "selected_inference_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^IF-[0-9]{1,3}$"
                }
              },
              "resource_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "event_cutoff": {
                "type": "integer",
                "minimum": 0
              },
              "workspace_revision": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "plan_ref",
              "graph_ref",
              "selected_fact_ids",
              "selected_inference_ids",
              "resource_ids",
              "event_cutoff",
              "workspace_revision"
            ]
          },
          "input_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "presenter_pin": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider",
              "model_id",
              "prompt_version",
              "context_builder_version",
              "tool_catalog_version"
            ],
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "model_id": {
                "type": "string",
                "minLength": 1
              },
              "prompt_version": {
                "type": "string",
                "minLength": 1
              },
              "context_builder_version": {
                "type": "string",
                "minLength": 1
              },
              "tool_catalog_version": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "status": {
            "enum": [
              "pending",
              "committed",
              "failed",
              "cancelled"
            ]
          },
          "phase": {
            "enum": [
              "running",
              "waiting_retry"
            ]
          },
          "retry_at": {
            "type": "string",
            "format": "date-time"
          },
          "error_class": {
            "enum": [
              "provider_failure",
              "timeout",
              "draft_invalid",
              "preflight_failed",
              "context_irreproducible",
              "internal_error",
              "RETRY_EXHAUSTED"
            ]
          },
          "sequence_id": {
            "type": "string",
            "pattern": "^PS-[0-9]{4,}$",
            "description": "presentation sequence 的 session 间唯一运行时 id（id-registry PS）。"
          },
          "cancel_reason": {
            "enum": [
              "cancelled",
              "superseded_by_new_input",
              "revision_changed",
              "session_closing"
            ]
          }
        },
        "required": [
          "request_id",
          "source_request_id",
          "decision_id",
          "scope",
          "reservation_revision",
          "epoch",
          "attempt",
          "max_attempts",
          "retry_policy_version",
          "timeout_ms",
          "retry_delays_ms",
          "context",
          "input_digest",
          "presenter_pin",
          "status"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "pending"
                }
              }
            },
            "then": {
              "required": [
                "phase"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "cancel_reason"
                    ]
                  },
                  {
                    "required": [
                      "error_class"
                    ]
                  },
                  {
                    "required": [
                      "sequence_id"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "failed"
                }
              }
            },
            "then": {
              "required": [
                "error_class"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "cancel_reason"
                    ]
                  },
                  {
                    "required": [
                      "phase"
                    ]
                  },
                  {
                    "required": [
                      "retry_at"
                    ]
                  },
                  {
                    "required": [
                      "sequence_id"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "committed"
                }
              }
            },
            "then": {
              "required": [
                "sequence_id"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "cancel_reason"
                    ]
                  },

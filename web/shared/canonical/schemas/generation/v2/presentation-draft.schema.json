{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ai-teaching.dev/generation/v2/presentation-draft.schema.json",
  "title": "PresentationDraft v2",
  "description": "Untrusted speech/tool intent; binding required only when the selected registered tool requires it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "ai_teaching_presentation_draft/v2"
    },
    "request_id": {
      "type": "string",
      "pattern": "^GR-[A-Za-z0-9._:-]{4,}$",
      "description": "服务器包装时填写的生成请求身份（id-registry GR）；模型原始输出不要求携带。"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "speech",
              "tool_intent"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "仅 type=speech。"
          },
          "basis_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "批准依据引用提议（RES-/VB-/FN-/IF-），编译期校验。"
          },
          "tool": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
            "description": "仅 type=tool_intent：公开工具目录中的 tool_id（如 geometry.emphasize、board.explain）。"
          },
          "args": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {
              "binding_ref": {
                "type": "string",
                "pattern": "^VB-[0-9]{1,3}$",
                "description": "题目资源绑定（planning/v6 resource_bindings；模型不得绕过绑定直造 target）。"
              },
              "params": {
                "type": "object",
                "description": "合法参数（由 presentation-tool-spec parameters 校验；不允许 HTML/JS/像素坐标）。"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "speech"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "text"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "tool"
                    ]
                  },
                  {
                    "required": [
                      "args"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "tool_intent"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "tool",
                "args"
              ],
              "not": {
                "required": [
                  "text"
                ]
              }
            }
          }
        ]
      },
      "description": "有界短段：生成→全段验证→提交→按序交付（计划 §3.2 MVP 策略）；不要求整节课。"
    }
  }
}

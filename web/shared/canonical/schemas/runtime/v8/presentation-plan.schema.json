{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ai-teaching.dev/runtime/v8/presentation-plan.schema.json",
  "title": "PresentationPlan v4",
  "description": "Generated sequence with persisted new fragments or hashed references to previously committed session content; no resolution frame.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "session_id",
    "sequence_id",
    "decision_id",
    "scope",
    "actions"
  ],
  "properties": {
    "schema": {
      "const": "ai_teaching_presentation_plan/v4"
    },
    "session_id": {
      "type": "string",
      "pattern": "^TS-[0-9]{4,}$"
    },
    "sequence_id": {
      "type": "string",
      "pattern": "^PS-[0-9]{4,}$",
      "description": "presentation sequence 的 session 间唯一运行时 id（id-registry PS）。"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^TD-[A-Za-z0-9._:-]{4,}$"
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "protocol_id",
            "beat_id"
          ],
          "properties": {
            "kind": {
              "const": "approved"
            },
            "protocol_id": {
              "type": "string",
              "pattern": "^PR-[A-Z0-9]+-[0-9]{3,}$"
            },
            "beat_id": {
              "type": "string",
              "pattern": "^BT-[0-9]{1,3}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "inquiry_id",
            "local_protocol_id",
            "local_beat_id",
            "anchor"
          ],
          "properties": {
            "kind": {
              "const": "local"
            },
            "inquiry_id": {
              "type": "string",
              "pattern": "^IQ-[A-Za-z0-9._:-]{4,}$"
            },
            "local_protocol_id": {
              "type": "string",
              "pattern": "^LPR-[A-Za-z0-9._:-]{4,}$"
            },
            "local_beat_id": {
              "type": "string",
              "pattern": "^LBT-[0-9]{1,3}$"
            },
            "anchor": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "protocol_id",
                "beat_id"
              ],
              "properties": {
                "protocol_id": {
                  "type": "string",
                  "pattern": "^PR-[A-Z0-9]+-[0-9]{3,}$"
                },
                "beat_id": {
                  "type": "string",
                  "pattern": "^BT-[0-9]{1,3}$"
                }
              }
            }
          }
        }
      ],
      "description": "TeachingScopeRef（与 state/v3、runtime/v8 同构）。"
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "attempt",
        "input_digest",
        "presenter_pin",
        "epoch"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^GR-[A-Za-z0-9._:-]{4,}$",
          "description": "id-registry GR。"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "input_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "presenter_pin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "model_id",
            "prompt_version",
            "context_builder_version",
            "tool_catalog_version"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model_id": {
              "type": "string",
              "minLength": 1
            },
            "prompt_version": {
              "type": "string",
              "minLength": 1
            },
            "context_builder_version": {
              "type": "string",
              "minLength": 1
            },
            "tool_catalog_version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "epoch": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "整段生成 provenance；model-generated 序列必带（镜像强制）——approved-resource 确定性序列不带。"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "kind"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 0,
            "description": "必须等于数组下标（0 起连续、唯一）——镜像强制。"
          },
          "kind": {
            "enum": [
              "voice",
              "workspace"
            ]
          },
          "basis_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "批准依据引用（RES- 解释资源 / VB- 绑定 / FN-|IF- 图节点）；编译期由服务端绑定，模型只经 draft basis_refs 提议。"
          },
          "voice_action": {
            "$ref": "#/$defs/voice_action_body"
          },
          "workspace_action": {
            "$ref": "#/$defs/workspace_action_body"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "voice"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "voice_action"
              ],
              "not": {
                "required": [
                  "workspace_action"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "workspace"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "workspace_action"
              ],
              "not": {
                "required": [
                  "voice_action"
                ]
              }
            }
          }
        ]
      },
      "description": "有序判别联合：{ordinal, kind=voice, voice_action, basis_refs?} | {ordinal, kind=workspace, workspace_action, basis_refs?}。"
    },
    "explanation_fragments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fragment_id",
          "kind",
          "content",
          "basis_refs",
          "origin_generation"
        ],
        "properties": {
          "fragment_id": {
            "type": "string",
            "pattern": "^EF-[A-Za-z0-9._:-]{4,}$",
            "description": "id-registry EF（session runtime；编译器分配，模型不填）。"
          },
          "kind": {
            "enum": [
              "approved_math_note",
              "relation_note",
              "explanation_text"
            ],
            "description": "approved_math_note=批准公式引用笔记；relation_note=批准关系引用；explanation_text=纯解释文本。数学表达第一版以批准公式/关系引用为主，自由改写数学式需另行等价性验证。"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "description": "呈现文本（含批准表达引用的渲染形式）。"
          },
          "basis_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "批准依据引用（FN-/IF-/RES-/VB-；来源与支持等级审计对象）。"
          },
          "origin_generation": {
            "type": "string",
            "pattern": "^GR-[A-Za-z0-9._:-]{4,}$",
            "description": "来源生成请求（GR-）；确定性 fragment 可缺省。"
          },
          "attach_to_entry": {
            "type": "string",
            "pattern": "^BE-[0-9]{1,3}$",
            "description": "附着到已有 Board 条目（布局语义；非像素坐标）。"
          }
        },
        "description": "已验证、随序列落库的解释内容；无 visible，真实 Workspace 在该动作 applied 后才显示。恢复不得依赖模型重生成或进程缓存。"
      },
      "description": "本序列 board.explain 引用的不可变内容。ID 唯一、引用闭合、origin_generation 对账由两语言镜像校验。"
    },
    "existing_fragment_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fragment_id": {
            "type": "string",
            "pattern": "^EF-[A-Za-z0-9._:-]{4,}$"
          },
          "source_sequence_id": {
            "type": "string",
            "pattern": "^PS-[0-9]{4,}$",
            "description": "presentation sequence 的 session 间唯一运行时 id（id-registry PS）。"
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "fragment_id",
          "source_sequence_id",
          "content_hash"
        ]
      },
      "minItems": 1
    }
  },
  "$defs": {
    "voice_action_body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "decision_id",
        "text",
        "source"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "pattern": "^VA-[A-Za-z0-9._:-]{4,}$"
        },
        "decision_id": {
          "type": "string",
          "pattern": "^TD-[A-Za-z0-9._:-]{4,}$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "approved-resource",
            "model-generated",
            "deterministic-scaffold"
          ]
        },
        "resource_ref": {
          "type": "string",
          "pattern": "^RES[0-9]{1,3}$"
        },
        "generation_id": {
          "type": "string",
          "pattern": "^VG-[A-Za-z0-9._:-]{4,}$"
        },
        "interruptible": {
          "type": "boolean"
        },
        "intent": {
          "enum": [
            "narrate",
            "question",
            "feedback"
          ]
        }
      },
      "description": "voice-action/v1 body 同构（无外层 schema/session_id）。source=approved-resource 必带 resource_ref、source=model-generated 必带 generation_id（镜像强制，同 v2）。"
    },
    "workspace_action_body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "decision_id",
        "surface",
        "capability",
        "origin",
        "reveal_scope"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "pattern": "^WSA-[A-Za-z0-9._:-]{4,}$"
        },
        "decision_id": {
          "type": "string",
          "pattern": "^TD-[A-Za-z0-9._:-]{4,}$"
        },
        "surface": {
          "enum": [
            "geometry",
            "solution_board"
          ]
        },
        "capability": {
          "type": "string",
          "minLength": 1,
          "description": "开放 capability 字符串（registry 校验）；board.explain 等新工具经此进入（裁定 B6），command_payload 只携编译器分配的 EF- fragment 引用。"
        },
        "origin": {
          "const": "tutor"
        },
        "target_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "command_payload": {
          "type": "string"
        },
        "reveal_scope": {
          "enum": [
            "none",
            "target_highlight",
            "step_narration",
            "intermediate_result",
            "final_result"
          ]
        },
        "presentation_only": {
          "type": "boolean"
        }
      },
      "description": "workspace-surface-action/v1 body 同构（无外层 schema/session_id）。"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "actions": {
            "contains": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "voice"
                },
                "voice_action": {
                  "type": "object",
                  "properties": {
                    "source": {
                      "const": "model-generated"
                    }
                  },
                  "required": [
                    "source"
                  ]
                }
              },
              "required": [
                "kind",
                "voice_action"
              ]
            }
          }
        },
        "required": [
          "actions"
        ]
      },
      "then": {
        "required": [
          "generation"
        ]
      }
    },
    {
      "if": {
        "required": [
          "explanation_fragments"
        ]
      },
      "then": {
        "required": [
          "generation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "actions": {
            "contains": {
              "properties": {
                "workspace_action": {
                  "properties": {
                    "capability": {
                      "const": "board.explain"
                    }
                  },
                  "required": [
                    "capability"
                  ]
                }
              },
              "required": [
                "workspace_action"
              ]
            }
          }
        },
        "required": [
          "actions"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "explanation_fragments"
            ]
          },
          {
            "required": [
              "existing_fragment_refs"
            ]
          }
        ]
      }
    }
  ]
}

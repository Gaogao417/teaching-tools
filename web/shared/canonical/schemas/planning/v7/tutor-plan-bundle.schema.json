{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ai-teaching.dev/planning/v7/tutor-plan-bundle.schema.json",
  "title": "TutorPlanBundle v7",
  "description": "F7 simplified presentation: existing teaching plan plus resource bindings; no refinement tree or new checkpoints.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifact_id",
    "version",
    "status",
    "question_ref",
    "approach_set_ref",
    "solution_graph_ref",
    "policy_profile_ref",
    "default_resolution_profile_id",
    "resolution_profiles",
    "chunk_graph",
    "solution_regions",
    "chunks",
    "resources",
    "build_provenance",
    "content_hash",
    "artifact_uri",
    "resource_bindings"
  ],
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "version",
        "content_hash"
      ],
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^v[0-9]+$"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "solutionRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_ids",
        "inference_ids"
      ],
      "properties": {
        "fact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^FN-[0-9]{1,3}$"
          }
        },
        "inference_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^IF-[0-9]{1,3}$"
          }
        }
      }
    }
  },
  "properties": {
    "schema": {
      "const": "ai_teaching_tutor_plan_bundle/v7"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^TP-[A-Z0-9]+-[0-9]{3,}$"
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "status": {
      "enum": [
        "Draft",
        "InReview",
        "Approved",
        "Stale",
        "Disabled",
        "Superseded"
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "approved_at"
      ],
      "properties": {
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "review_note": {
          "type": "string"
        }
      }
    },
    "question_ref": {
      "$ref": "#/$defs/artifactRef"
    },
    "approach_set_ref": {
      "$ref": "#/$defs/artifactRef"
    },
    "solution_graph_ref": {
      "$ref": "#/$defs/artifactRef"
    },
    "policy_profile_ref": {
      "$ref": "#/$defs/artifactRef"
    },
    "default_resolution_profile_id": {
      "type": "string",
      "pattern": "^RP-[0-9]{1,3}$"
    },
    "resolution_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_id",
          "learner_description",
          "default_view",
          "available_views",
          "chunk_ids"
        ],
        "properties": {
          "profile_id": {
            "type": "string",
            "pattern": "^RP-[0-9]{1,3}$"
          },
          "learner_description": {
            "type": "string",
            "minLength": 1
          },
          "default_view": {
            "enum": [
              "chunk",
              "beat",
              "fine"
            ]
          },
          "available_views": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "chunk",
                "beat",
                "fine"
              ]
            }
          },
          "chunk_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^CH-[0-9]{1,3}$"
            }
          }
        }
      }
    },
    "chunk_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_chunk_id",
        "completion_chunk_ids",
        "edges"
      ],
      "properties": {
        "entry_chunk_id": {
          "type": "string",
          "pattern": "^CH-[0-9]{1,3}$"
        },
        "completion_chunk_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CH-[0-9]{1,3}$"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from_chunk_id",
              "to_chunk_id",
              "on"
            ],
            "properties": {
              "from_chunk_id": {
                "type": "string",
                "pattern": "^CH-[0-9]{1,3}$"
              },
              "to_chunk_id": {
                "type": "string",
                "pattern": "^CH-[0-9]{1,3}$"
              },
              "on": {
                "enum": [
                  "complete",
                  "alternate",
                  "needs_support"
                ]
              }
            }
          }
        }
      }
    },
    "solution_regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "region_id",
          "label",
          "fine_refs"
        ],
        "properties": {
          "region_id": {
            "type": "string",
            "pattern": "^SR-[0-9]{1,3}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "fine_refs": {
            "$ref": "#/$defs/solutionRefs"
          },
          "local_protocol_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/artifactRef"
            }
          }
        }
      }
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chunk_id",
          "title",
          "instructional_intent",
          "entry_state",
          "exit_understanding",
          "source_subgraph_refs",
          "protocol_refs",
          "teacher_narration_refs",
          "presentation_groups",
          "expandable_region_ids"
        ],
        "properties": {
          "chunk_id": {
            "type": "string",
            "pattern": "^CH-[0-9]{1,3}$"
          },
          "part_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "instructional_intent": {
            "type": "string",
            "minLength": 1
          },
          "entry_state": {
            "type": "string",
            "minLength": 1
          },
          "exit_understanding": {
            "type": "string",
            "minLength": 1
          },
          "source_subgraph_refs": {
            "$ref": "#/$defs/solutionRefs"
          },
          "protocol_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/artifactRef"
            }
          },
          "teacher_narration_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^RES[0-9]{1,3}$"
            }
          },
          "presentation_groups": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "group_id",
                "label",
                "fine_refs"
              ],
              "properties": {
                "group_id": {
                  "type": "string",
                  "pattern": "^PG-[0-9]{1,3}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "fine_refs": {
                  "$ref": "#/$defs/solutionRefs"
                }
              }
            }
          },
          "expandable_region_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^SR-[0-9]{1,3}$"
            }
          },
          "resource_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^RES[0-9]{1,3}$"
            }
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource_id",
          "kind",
          "source"
        ],
        "properties": {
          "resource_id": {
            "type": "string",
            "pattern": "^RES[0-9]{1,3}$"
          },
          "kind": {
            "enum": [
              "explanation",
              "diagnostic_probe",
              "repair",
              "action_template",
              "workspace",
              "voice_seed",
              "support"
            ]
          },
          "beat_ref": {
            "type": "string",
            "pattern": "^BT-[0-9]{1,3}$"
          },
          "source": {
            "enum": [
              "authored",
              "reused",
              "agent_generated"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "solution_refs": {
            "$ref": "#/$defs/solutionRefs"
          }
        }
      }
    },
    "build_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model_id",
        "workflow_version",
        "run_id",
        "built_at",
        "runtime_registry_version",
        "compiler_version",
        "materializer_version"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "workflow_version": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "built_at": {
          "type": "string",
          "format": "date-time"
        },
        "runtime_registry_version": {
          "type": "string",
          "minLength": 1
        },
        "compiler_version": {
          "type": "string",
          "minLength": 1
        },
        "materializer_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifact_uri": {
      "type": "string",
      "pattern": "^artifact://tutor-plan/TP-[A-Z0-9]+-[0-9]{3,}@v[0-9]+$"
    },
    "resource_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "binding_id",
          "binding_kind",
          "purpose"
        ],
        "properties": {
          "binding_id": {
            "type": "string",
            "pattern": "^VB-[0-9]{1,3}$",
            "description": "id-registry VB（plan-local）。"
          },
          "binding_kind": {
            "enum": [
              "geometry",
              "board",
              "explanation"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "description": "本题该绑定对象是什么（教研文本）。"
          },
          "geometry_target": {
            "type": "string",
            "minLength": 1,
            "description": "仅 binding_kind=geometry：Workspace catalog 实体 id（模型不得猜坐标/从点名字符串重建几何）。"
          },
          "semantic_role": {
            "type": "string",
            "minLength": 1,
            "description": "仅 binding_kind=geometry：语义角色（如 angle-pair / carrier-segment）。"
          },
          "allowed_template_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "仅 binding_kind=geometry：允许的构造模板（declared output handle 由此模板声明）。"
          },
          "board_entry_id": {
            "type": "string",
            "pattern": "^BE-[0-9]{1,3}$",
            "description": "仅 binding_kind=board：批准结论/条目 entry。"
          },
          "reveal_after_gate": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "protocol_id": {
                "type": "string",
                "pattern": "^PR-[A-Z0-9]+-[0-9]{3,}$"
              },
              "gate_id": {
                "type": "string",
                "pattern": "^GT-[0-9]{1,3}$"
              }
            },
            "required": [
              "protocol_id",
              "gate_id"
            ]
          },
          "basis_refs": {
            "$ref": "#/$defs/solutionRefs",
            "description": "仅 binding_kind=explanation：批准 Fact/Inference 依据（模型改写数学式必须有此依据——自由改写需另行等价验证，不由本 schema 冒充）。"
          },
          "presentation_resource": {
            "type": "string",
            "pattern": "^RES[0-9]{1,3}$",
            "description": "仅 binding_kind=explanation：参考表达资源（必须在 resources 内——镜像强制）。"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "binding_kind": {
                  "const": "geometry"
                }
              },
              "required": [
                "binding_kind"
              ]
            },
            "then": {
              "required": [
                "geometry_target",
                "semantic_role",
                "allowed_template_ids"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "binding_kind": {
                  "const": "board"
                }
              },
              "required": [
                "binding_kind"
              ]
            },
            "then": {
              "required": [
                "board_entry_id",
                "reveal_after_gate"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "binding_kind": {
                  "const": "explanation"
                }
              },
              "required": [
                "binding_kind"
              ]
            },
            "then": {
              "required": [
                "basis_refs",
                "presentation_resource"
              ]
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "Approved"
          }
        }
      },
      "then": {
        "required": [
          "approval"
        ]
      }
    }
  ]
}

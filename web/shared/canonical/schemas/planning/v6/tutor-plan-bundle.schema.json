{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ai-teaching.dev/planning/v6/tutor-plan-bundle.schema.json",
  "title": "TutorPlanBundle v6",
  "description": "F7 RT0 集中合同波（2026-09-07，f7-rt0-baseline-freeze 清单 2 #1）：在 v5 全部字段（逐字段保留、不改语义）基础上，把「资源清单」升级为「可执行展开结构」——必填 refinement_spec（RefinementUnit 层级 / chunk 默认 frontier / region 绑定 / checkpoint）与必填 resource_bindings（题目级几何/Board/解释绑定 VB-）。RG 仍是最细数学真源；RefinementSpec 是同一批准子图的讲解分组，不复制数学图、不以全局 detail_level 替代结构。编译门禁（无环、子单位核心 refs 属于父单位、子单位覆盖父单位、默认 frontier 覆盖 chunk、checkpoint/binding/资源可解析、展开依赖可达、返回锚点合法）中 schema 可表达部分下沉 allOf if/then，其余由双语言镜像 superRefine/model_validator 逐条一致强制，最终由 materializer fail closed。旧 v5 资产维持历史语义，reader 不把 resolution_profiles 自动转换为 refinement。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "artifact_id", "version", "status", "question_ref", "approach_set_ref", "solution_graph_ref", "policy_profile_ref", "default_resolution_profile_id", "resolution_profiles", "chunk_graph", "solution_regions", "chunks", "resources", "refinement_spec", "resource_bindings", "build_provenance", "content_hash", "artifact_uri"],
  "$defs": {
    "artifactRef": {
      "type": "object", "additionalProperties": false, "required": ["artifact_id", "version", "content_hash"],
      "properties": {
        "artifact_id": {"type": "string"},
        "version": {"type": "string", "pattern": "^v[0-9]+$"},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "solutionRefs": {
      "type": "object", "additionalProperties": false, "required": ["fact_ids", "inference_ids"],
      "properties": {
        "fact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^FN-[0-9]{1,3}$"}},
        "inference_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^IF-[0-9]{1,3}$"}}
      }
    },
    "refinementUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "fine_refs", "prerequisite_refs", "child_unit_ids", "explanation_resource_refs", "visual_binding_refs", "checkpoint_ref"],
      "properties": {
        "unit_id": {"type": "string", "pattern": "^RU-[0-9]{1,3}$", "description": "id-registry RU（plan-local）。"},
        "fine_refs": {"$ref": "#/$defs/solutionRefs", "description": "本单位的 RG fine 引用（核心 refs；子单位核心必须属于父单位——镜像强制）。"},
        "prerequisite_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^RU-[0-9]{1,3}$"}, "description": "跨单元共享前提单位（不算重复目标）。"},
        "child_unit_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^RU-[0-9]{1,3}$"}, "description": "空集合 = 本计划批准的最细讲解单位。"},
        "explanation_resource_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^RES[0-9]{1,3}$"}, "description": "本单位解释依据资源（必须在本 bundle resources 内——镜像强制）。"},
        "visual_binding_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^VB-[0-9]{1,3}$"}, "description": "视觉/操作绑定（必须在 resource_bindings 内——镜像强制）。"},
        "checkpoint_ref": {"type": "string", "pattern": "^CP-[0-9]{1,3}$", "description": "本单位批准检查（必须在 refinement_spec.checkpoints 内——镜像强制）。呈现完成不等于 checkpoint 通过。"}
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_id", "evidence_kind", "requirement"],
      "properties": {
        "checkpoint_id": {"type": "string", "pattern": "^CP-[0-9]{1,3}$"},
        "evidence_kind": {"enum": ["student_answer", "workspace_command", "student_confirmation", "semantic_gate_pass", "tutor_observed"], "description": "检查证据类型；semantic_gate_pass=经 Gate 模型语义判定（如自解释），非点击确认。"},
        "requirement": {"type": "string", "minLength": 1, "description": "通过要求（教研批准文本）。"},
        "gate": {
          "type": "object", "additionalProperties": false, "required": ["gate_id"],
          "properties": {
            "gate_id": {"type": "string", "pattern": "^GT-[0-9]{1,3}$", "description": "引用 TeachingProtocol 既有 GT-（协议本身不升版，RT0 裁定 B3）。"},
            "capability": {"type": "string", "minLength": 1},
            "graph_fact_id": {"type": "string", "pattern": "^FN-[0-9]{1,3}$"}
          }
        }
      }
    }
  },
  "properties": {
    "schema": {"const": "ai_teaching_tutor_plan_bundle/v6"},
    "artifact_id": {"type": "string", "pattern": "^TP-[A-Z0-9]+-[0-9]{3,}$"},
    "version": {"type": "string", "pattern": "^v[0-9]+$"},
    "status": {"enum": ["Draft", "InReview", "Approved", "Stale", "Disabled", "Superseded"]},
    "approval": {"type": "object", "additionalProperties": false, "required": ["reviewer_id", "approved_at"], "properties": {"reviewer_id": {"type": "string", "minLength": 1}, "approved_at": {"type": "string", "format": "date-time"}, "review_note": {"type": "string"}}},
    "question_ref": {"$ref": "#/$defs/artifactRef"},
    "approach_set_ref": {"$ref": "#/$defs/artifactRef"},
    "solution_graph_ref": {"$ref": "#/$defs/artifactRef"},
    "policy_profile_ref": {"$ref": "#/$defs/artifactRef"},
    "default_resolution_profile_id": {"type": "string", "pattern": "^RP-[0-9]{1,3}$"},
    "resolution_profiles": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["profile_id", "learner_description", "default_view", "available_views", "chunk_ids"],
        "properties": {
          "profile_id": {"type": "string", "pattern": "^RP-[0-9]{1,3}$"},
          "learner_description": {"type": "string", "minLength": 1},
          "default_view": {"enum": ["chunk", "beat", "fine"]},
          "available_views": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["chunk", "beat", "fine"]}},
          "chunk_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^CH-[0-9]{1,3}$"}}
        }
      }
    },
    "chunk_graph": {
      "type": "object", "additionalProperties": false, "required": ["entry_chunk_id", "completion_chunk_ids", "edges"],
      "properties": {
        "entry_chunk_id": {"type": "string", "pattern": "^CH-[0-9]{1,3}$"},
        "completion_chunk_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^CH-[0-9]{1,3}$"}},
        "edges": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["from_chunk_id", "to_chunk_id", "on"], "properties": {"from_chunk_id": {"type": "string", "pattern": "^CH-[0-9]{1,3}$"}, "to_chunk_id": {"type": "string", "pattern": "^CH-[0-9]{1,3}$"}, "on": {"enum": ["complete", "alternate", "needs_support"]}}}}
      }
    },
    "solution_regions": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["region_id", "label", "fine_refs"], "properties": {"region_id": {"type": "string", "pattern": "^SR-[0-9]{1,3}$"}, "label": {"type": "string", "minLength": 1}, "fine_refs": {"$ref": "#/$defs/solutionRefs"}, "local_protocol_refs": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}}}}
    },
    "chunks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["chunk_id", "title", "instructional_intent", "entry_state", "exit_understanding", "source_subgraph_refs", "protocol_refs", "teacher_narration_refs", "presentation_groups", "expandable_region_ids"],
        "properties": {
          "chunk_id": {"type": "string", "pattern": "^CH-[0-9]{1,3}$"},
          "part_id": {"type": "string", "pattern": "^[1-9][0-9]{0,2}$"},
          "title": {"type": "string", "minLength": 1},
          "instructional_intent": {"type": "string", "minLength": 1},
          "entry_state": {"type": "string", "minLength": 1},
          "exit_understanding": {"type": "string", "minLength": 1},
          "source_subgraph_refs": {"$ref": "#/$defs/solutionRefs"},
          "protocol_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifactRef"}},
          "teacher_narration_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^RES[0-9]{1,3}$"}},
          "presentation_groups": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["group_id", "label", "fine_refs"], "properties": {"group_id": {"type": "string", "pattern": "^PG-[0-9]{1,3}$"}, "label": {"type": "string", "minLength": 1}, "fine_refs": {"$ref": "#/$defs/solutionRefs"}}}},
          "expandable_region_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^SR-[0-9]{1,3}$"}},
          "resource_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^RES[0-9]{1,3}$"}}
        }
      }
    },
    "resources": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["resource_id", "kind", "source"], "properties": {"resource_id": {"type": "string", "pattern": "^RES[0-9]{1,3}$"}, "kind": {"enum": ["explanation", "diagnostic_probe", "repair", "action_template", "workspace", "voice_seed", "support"]}, "beat_ref": {"type": "string", "pattern": "^BT-[0-9]{1,3}$"}, "source": {"enum": ["authored", "reused", "agent_generated"]}, "content": {"type": "string", "minLength": 1}, "solution_refs": {"$ref": "#/$defs/solutionRefs"}}}
    },
    "refinement_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units", "defaults_by_chunk", "region_bindings", "checkpoints"],
      "properties": {
        "units": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/refinementUnit"}, "description": "refinement 单位森林（父子分组，不复制 RG；无环——镜像强制）。"},
        "defaults_by_chunk": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["chunk_id", "frontier_unit_ids"],
            "properties": {
              "chunk_id": {"type": "string", "pattern": "^CH-[0-9]{1,3}$"},
              "frontier_unit_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^RU-[0-9]{1,3}$"}, "description": "默认讲出的单位集合；必须覆盖该 chunk 全部 fine refs（镜像强制）。"}
            }
          },
          "description": "每个 chunk 的默认 frontier（重复 chunk_id 禁止——镜像强制）。"
        },
        "region_bindings": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["region_id", "root_unit_ids"],
            "properties": {
              "region_id": {"type": "string", "pattern": "^SR-[0-9]{1,3}$"},
              "root_unit_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^RU-[0-9]{1,3}$"}, "description": "该可展开区域的 refinement 根单位。"}
            }
          }
        },
        "checkpoints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/checkpoint"}}
      },
      "description": "同批准子图的可执行讲解分组结构（架构 §3.1 拟议结构落合同）。"
    },
    "resource_bindings": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["binding_id", "binding_kind", "purpose"],
        "properties": {
          "binding_id": {"type": "string", "pattern": "^VB-[0-9]{1,3}$", "description": "id-registry VB（plan-local）。"},
          "binding_kind": {"enum": ["geometry", "board", "explanation"]},
          "purpose": {"type": "string", "minLength": 1, "description": "本题该绑定对象是什么（教研文本）。"},
          "geometry_target": {"type": "string", "minLength": 1, "description": "仅 binding_kind=geometry：Workspace catalog 实体 id（模型不得猜坐标/从点名字符串重建几何）。"},
          "semantic_role": {"type": "string", "minLength": 1, "description": "仅 binding_kind=geometry：语义角色（如 angle-pair / carrier-segment）。"},
          "allowed_template_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "description": "仅 binding_kind=geometry：允许的构造模板（declared output handle 由此模板声明）。"},
          "board_entry_id": {"type": "string", "pattern": "^BE-[0-9]{1,3}$", "description": "仅 binding_kind=board：批准结论/条目 entry。"},
          "reveal_after_checkpoint": {"type": "string", "pattern": "^CP-[0-9]{1,3}$", "description": "仅 binding_kind=board：哪个 checkpoint 通过后可揭示何种内容。"},
          "basis_refs": {"$ref": "#/$defs/solutionRefs", "description": "仅 binding_kind=explanation：批准 Fact/Inference 依据（模型改写数学式必须有此依据——自由改写需另行等价验证，不由本 schema 冒充）。"},
          "presentation_resource": {"type": "string", "pattern": "^RES[0-9]{1,3}$", "description": "仅 binding_kind=explanation：参考表达资源（必须在 resources 内——镜像强制）。"}
        },
        "allOf": [
          {
            "if": {"properties": {"binding_kind": {"const": "geometry"}}, "required": ["binding_kind"]},
            "then": {"required": ["geometry_target", "semantic_role", "allowed_template_ids"]}
          },
          {
            "if": {"properties": {"binding_kind": {"const": "board"}}, "required": ["binding_kind"]},
            "then": {"required": ["board_entry_id", "reveal_after_checkpoint"]}
          },
          {
            "if": {"properties": {"binding_kind": {"const": "explanation"}}, "required": ["binding_kind"]},
            "then": {"required": ["basis_refs", "presentation_resource"]}
          }
        ]
      },
      "description": "题目级呈现资源绑定（架构 §3.2）：绑定负责「本题对象是什么」，与通用工具注册（generation/v1 presentation-tool-spec）分开。"
    },
    "build_provenance": {"type": "object", "additionalProperties": false, "required": ["provider", "model_id", "workflow_version", "run_id", "built_at", "runtime_registry_version", "compiler_version", "materializer_version"], "properties": {"provider": {"type": "string", "minLength": 1}, "model_id": {"type": "string", "minLength": 1}, "workflow_version": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1}, "built_at": {"type": "string", "format": "date-time"}, "runtime_registry_version": {"type": "string", "minLength": 1}, "compiler_version": {"type": "string", "minLength": 1}, "materializer_version": {"type": "string", "minLength": 1}}},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifact_uri": {"type": "string", "pattern": "^artifact://tutor-plan/TP-[A-Z0-9]+-[0-9]{3,}@v[0-9]+$"}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "Approved"}}}, "then": {"required": ["approval"]}}]
}

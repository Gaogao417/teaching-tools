{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ai-teaching.dev/authoring/v4/teaching-approach.schema.json",
  "title": "TeachingApproach v4",
  "description": "F4 authoring-chain repair: the approved teacher approach explicitly aligns every TeachingStep to an upstream Approved ReviewedSolutionGraph. RG never depends on TA.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "artifact_id", "version", "status", "question_ref", "solution_graph_ref", "title", "goal", "steps", "evidence", "content_hash", "artifact_uri"],
  "properties": {
    "schema": {"const": "ai_teaching_teaching_approach/v4"},
    "artifact_id": {"type": "string", "pattern": "^TA-[A-Z0-9]+-[0-9]{3,}$"},
    "version": {"type": "string", "pattern": "^v[0-9]+$"},
    "status": {"enum": ["Draft", "InReview", "Approved", "Stale", "Disabled", "Superseded"]},
    "question_ref": {"$ref": "#/$defs/questionRef"},
    "solution_graph_ref": {"$ref": "#/$defs/graphRef"},
    "title": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "entry_signal": {"type": "string"},
    "steps": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["step_id", "intent", "narration", "expected_student_reasoning", "solution_refs"],
        "properties": {
          "step_id": {"type": "string", "pattern": "^S[0-9]{1,3}$"},
          "intent": {"type": "string", "minLength": 1},
          "narration": {"type": "string", "minLength": 1},
          "expected_student_reasoning": {"type": "string", "minLength": 1},
          "accepted_alternatives": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "common_errors": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "source_trace_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "solution_refs": {"$ref": "#/$defs/solutionRefs"}
        }
      }
    },
    "evidence": {"$ref": "#/$defs/evidence"},
    "approval": {"$ref": "#/$defs/approval"},
    "superseded_by": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "version"], "properties": {"artifact_id": {"type": "string", "pattern": "^TA-[A-Z0-9]+-[0-9]{3,}$"}, "version": {"type": "string", "pattern": "^v[0-9]+$"}}},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifact_uri": {"type": "string", "pattern": "^artifact://teaching-approach/[A-Za-z0-9-]+@v[0-9]+$"}
  },
  "$defs": {
    "questionRef": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "version", "content_hash"], "properties": {"artifact_id": {"type": "string", "pattern": "^QT-[A-Z0-9]+-[0-9]{3,}$"}, "version": {"type": "string", "pattern": "^v[0-9]+$"}, "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "part_id": {"type": "string", "pattern": "^[1-9][0-9]{0,2}$"}}},
    "graphRef": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "version", "content_hash"], "properties": {"artifact_id": {"type": "string", "pattern": "^RG-[A-Z0-9]+-[0-9]{3,}$"}, "version": {"type": "string", "pattern": "^v[0-9]+$"}, "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "solutionRefs": {"type": "object", "additionalProperties": false, "required": ["fact_ids", "inference_ids"], "properties": {"fact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^FN-[0-9]{1,3}$"}}, "inference_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^IF-[0-9]{1,3}$"}}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["audio", "transcripts"], "properties": {"audio": {"type": "array"}, "transcripts": {"type": "array"}, "polished": {"type": "array"}, "manual_edit_notes": {"type": "array", "items": {"type": "string"}}}},
    "approval": {"type": "object", "additionalProperties": false, "required": ["reviewer_id", "approved_at"], "properties": {"reviewer_id": {"type": "string", "minLength": 1}, "approved_at": {"type": "string", "format": "date-time"}, "review_note": {"type": "string"}}}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "Approved"}}}, "then": {"required": ["approval"]}},
    {"if": {"properties": {"status": {"const": "Superseded"}}}, "then": {"required": ["superseded_by"]}}
  ]
}

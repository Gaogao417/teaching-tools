PORT=3001
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173
SQLITE_PATH=./data/trig-web.sqlite

# Multimodal classroom coach
# Claude Code inherits its GLM Anthropic-gateway settings from the process/user
# environment. Load your shell environment before starting the backend.
CLAUDE_CODE_BIN=claude
COACH_CLAUDE_MODEL=glm-5.2
COACH_CLAUDE_TIMEOUT_MS=45000

# Shared DashScope key for Qwen ASR and CosyVoice TTS. Never expose it to Vite.
DASHSCOPE_API_KEY=
DASHSCOPE_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
COACH_ASR_MODEL=qwen3-asr-flash

# Coach answer provider: "cosyvoice" (default, ASR→GLM answer→CosyVoice TTS) or
# "omni" (a single Qwen3.5-Omni call that listens and replies with natural
# speech, replacing all three legs). Omni reuses DASHSCOPE_API_KEY and the
# DASHSCOPE_COMPATIBLE_BASE_URL above; qwen3.5-omni-plus is Beijing-region only.
COACH_ANSWER_PROVIDER=cosyvoice
COACH_OMNI_MODEL=qwen3.5-omni-plus
# Valid qwen-omni audio voices: Tina / Ethan / Serena (NOT Cherry, which is qwen3-tts only).
COACH_OMNI_VOICE=Tina
COACH_OMNI_TIMEOUT_MS=45000

# CosyVoice-v3-plus speech backend (used when the request picks voiceModel
# "cosyvoice", or COACH_ANSWER_PROVIDER=cosyvoice). Streams raw MP3 over a
# DashScope duplex WebSocket; the generic host below needs no workspace id.
DASHSCOPE_WS_BASE_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference/
COACH_COSY_MODEL=cosyvoice-v3-plus
COACH_COSY_VOICE=longanyang
COACH_COSY_TIMEOUT_MS=45000

# Full-duplex realtime voice coach (qwen-omni-realtime, OpenAI-realtime WS
# protocol). The browser streams 16 kHz PCM to the backend relay, which bridges
# to DashScope and streams 24 kHz PCM replies back. Generic host needs no
# workspace id. COACH_REALTIME_MAX_MS caps a single call (default 600000 = 10m).
DASHSCOPE_REALTIME_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
COACH_REALTIME_MODEL=qwen3.5-omni-plus-realtime
COACH_REALTIME_VOICE=Ethan
COACH_REALTIME_MAX_MS=600000

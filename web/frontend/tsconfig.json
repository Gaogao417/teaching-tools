{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "zod": ["../backend/node_modules/zod/index.d.ts"]
    }
  },
  "include": ["src", "../shared/**/*.ts"],
  "exclude": ["src/poc/geometry-actions/__tests__", "../shared/canonical/**"]
}
